# HTTP
LISTEN=:3000

# ── 체인 어드레싱 (동적 키 — internal/chain.Registry가 조회) ──
# 단일 체인 기본값. 체인별 설정이 없으면 이 RPC 사용.
RPC_URL=http://localhost:8545
# 체인별 RPC (RPC_URL_<chainId> 우선). 멀티체인 지원.
RPC_URL_11155111=https://sepolia.example/rpc
RPC_URL_43113=https://fuji.example/rpc
RPC_URL_56357=https://kcp.example/rpc
# 모든 체인 공통 EntryPoint 주소 (필수).
ENTRYPOINT_ADDRESS=0x0000000000000000000000000000000000000000
# CREATE2 Factory (CREATE2_FACTORY_ADDRESS_<chainId> 우선).
# CREATE2_FACTORY_ADDRESS=0x...
# EoaFundedSplit 라우터 (EOFS_PROXY_ADDRESS_<chainId> 우선).
# EOFS_PROXY_ADDRESS=0x...

# 요청에 chainId가 없을 때 사용할 기본 체인 ID (선택).
DEFAULT_CHAIN_ID=56357

# ── Redis (nonce 분산락 + 라운드로빈 커서) ──
# 멀티프로세스 배포 시 필수. 미설정 시 인메모리 락만 — 단일 인스턴스 전용.
REDIS_URL=redis://localhost:6379
# 또는 REDIS_HOST/REDIS_PORT/REDIS_PASSWORD
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_PASSWORD=
# 월렛별 nonce 락 TTL(ms).
NONCE_LOCK_TTL_MS=30000

# ── 키 관리 (멀티번들러 핫월렛 풀) ──
# 운영: 암호화 keystore(SQLite) + NHN KMS. 평문 키 금지.
#   keystore 행:
#     bundler_key_<chainId>_0, bundler_key_<chainId>_1, ...  ← 체인별 핫월렛 풀(제출용, 라운드로빈)
#     owner_key                                               ← 풀 없을 때 단일 키 하위호환
#     server_key1 / server_key2                               ← 2-of-3 공동서명자(풀 아님)
#   풀 크기는 존재하는 bundler_key_<chainId>_* 개수로 자동 결정.
# NHN_APPKEY=<your_nhn_appkey>
# NHN_KMS_BASE_URL=                # 미설정 시 NHN 기본 엔드포인트
# KEY_DB_PATH=./keys.db            # 암호화 keystore 경로 (미설정 시 env fallback 모드)
# KEY_NAME=owner_key

# 로컬/테스트 fallback 키(64 hex, 0x 선택). 설정 시 단일 핫월렛 풀로 동작. 운영에서는 비워둘 것.
# OWNER_KEY=0x...
# BUNDLER_PRIVATE_KEY=0x...        # OWNER_KEY 대체 이름
# SERVER_KEY1=0x...
# SERVER_KEY2=0x...

# ── UserOp(Account ERC20/native) maxFee ──
# 미설정 시 RPC + Sepolia/Fuji/KCP 공통 하한(500/50 gwei) 보정. 전역 또는 체인별 덮어쓰기.
# USEROP_MAX_FEE_PER_GAS_GWEI=500
# USEROP_MAX_PRIORITY_FEE_PER_GAS_GWEI=50
# USEROP_MAX_FEE_PER_GAS_GWEI_56357=2000
# USEROP_MAX_PRIORITY_FEE_PER_GAS_GWEI_56357=100

# ── 로깅 ──
# 운영(ELK)에서는 LOG_PRETTY=false → pino 포맷 JSON.
LOG_LEVEL=debug
LOG_PRETTY=true
